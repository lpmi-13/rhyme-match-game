{
  "name": "rhymez",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "An offline-friendly rhyme-matching game for English language learners.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:security": "docker run --rm -e SCAN_URL=\"http://host.docker.internal:4173\" lirantal/is-website-vulnerable:latest",
    "test:security": "npm run build && npx -y start-server-and-test preview http://localhost:4173 docker:security"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
